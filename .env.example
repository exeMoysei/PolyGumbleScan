# Copy to .env on the VPS and fill in. Never commit .env. Names only — no secrets in this file.
POSTGRES_PASSWORD=
POLYBOT_ENV=prod
POLYBOT_LOG_LEVEL=INFO
POLYBOT_TELEGRAM_BOT_TOKEN=
# JSON list of Telegram user ids allowed to review mappings and pause publishing
POLYBOT_ADMIN_IDS=[]
POLYBOT_TECH_CHAT_ID=
POLYBOT_ODDS_API_KEY=
POLYBOT_ODDS_API_REGIONS=["eu"]
POLYBOT_ODDS_API_BOOKMAKERS=[]
POLYBOT_LEAGUES=["nba"]
POLYBOT_DEFAULT_BUDGET=100
POLYBOT_MIN_PROFIT=1.00
POLYBOT_MIN_ROI=0.005
POLYBOT_POLYMARKET_WS=false
POLYBOT_AUTO_APPROVE_STRONG_MATCHES=false
# POLYBOT_FX_STATIC={"USDC/USD": "1"}
# POLYBOT_FX_RESERVE_BPS=30
# POLYBOT_SPORTSBOOK_MAX_STAKE={"oddsapi:pinnacle:eu": "500"}
# Premium (US12): free plan limits + paid plans in Telegram Stars (days -> Stars). Off by default.
POLYBOT_PREMIUM_ENABLED=false
