# Copy to .env and fill in. Never commit .env. Names only — no secrets in this file.
# Local start (python -m polybot run) needs only the Telegram token and your admin id; it uses a SQLite file.
POLYBOT_TELEGRAM_BOT_TOKEN=
# JSON list of Telegram user ids allowed to review mappings and pause publishing, e.g. [123456789]
POLYBOT_ADMIN_IDS=[]
# Docker Compose / server only (PostgreSQL + Redis):
POSTGRES_PASSWORD=
# POLYBOT_DATABASE_URL=sqlite+aiosqlite:///polybot.db
# POLYBOT_REDIS_URL=
POLYBOT_ENV=dev
POLYBOT_LOG_LEVEL=INFO
POLYBOT_TECH_CHAT_ID=
POLYBOT_ODDS_API_KEY=
POLYBOT_ODDS_API_REGIONS=["eu"]
POLYBOT_ODDS_API_BOOKMAKERS=[]
POLYBOT_LEAGUES=["nba","nhl","epl"]
POLYBOT_DEFAULT_BUDGET=100
POLYBOT_MIN_PROFIT=1.00
POLYBOT_MIN_ROI=0.005
POLYBOT_POLYMARKET_WS=false
POLYBOT_AUTO_APPROVE_STRONG_MATCHES=false
# POLYBOT_FX_STATIC={"USDC/USD": "1"}
# POLYBOT_FX_RESERVE_BPS=30
# POLYBOT_SPORTSBOOK_MAX_STAKE={"oddsapi:pinnacle:eu": "500"}
# Premium (US12): free plan limits + paid plans in Telegram Stars (days -> Stars). Off by default.
POLYBOT_PREMIUM_ENABLED=false
# POLYBOT_PREMIUM_PLANS={"30": 250, "90": 600}
# POLYBOT_FREE_DAILY_ALERTS=3
# POLYBOT_FREE_SIGNALS_SHOWN=1
# POLYBOT_FREE_MAX_BUDGET=250
# POLYBOT_SUPPORT_CONTACT=
# Polymarket-only alerts: new wallets with big bets, followed wallets, YES sum < 1
# POLYBOT_WHALE_MIN_USDC=5000
# POLYBOT_WHALE_MAX_PRIOR_TRADES=10
# POLYBOT_WHALE_MAX_AGE_DAYS=7
# POLYBOT_FOLLOW_DEFAULT_MIN_USDC=100
# POLYBOT_YES_SUM_BUDGET=1000
# POLYBOT_YES_SUM_MIN_PROFIT=0.50
