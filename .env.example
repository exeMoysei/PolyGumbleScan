# Skopiuj ten plik do .env i uzupełnij wartości: cp .env.example .env

# Token bota z @BotFather (wymagany do uruchomienia bota)
BOT_TOKEN=

# Baza danych (domyślnie lokalny SQLite; na produkcji np. PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./polygumblescan.db

# Polymarket Gamma API
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Poziom logowania: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
